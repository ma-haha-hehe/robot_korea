FROM ros:humble-ros-base-jammy

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip python3-colcon-common-extensions \
    ros-humble-control-msgs ros-humble-moveit \
    ros-humble-moveit-resources-panda-moveit-config \
    ros-humble-ros2-control ros-humble-ros2-controllers \
    ros-humble-rviz2 ros-humble-xacro libgl1 libglfw3 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-sim.txt /tmp/requirements-sim.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements-sim.txt PyYAML pytest
ENV OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1

WORKDIR /workspace
COPY src/mj_bridge src/mj_bridge
COPY examples examples
COPY scripts/import_workbenchmark_latest.py scripts/
ENV MJ_BRIDGE_BENCHMARK_CONFIG=/workspace/examples/config/plastic_benchmark.yaml
RUN . /opt/ros/humble/setup.sh && colcon build --base-paths src/mj_bridge --packages-select mj_bridge --symlink-install

ENTRYPOINT ["/bin/bash", "-lc"]
CMD [". /opt/ros/humble/setup.bash && . install/setup.bash && python3 scripts/import_workbenchmark_latest.py --output examples/products/workbenchmark_latest_20261014 --verify-task two_brick_stack_001.yaml && mkdir -p runs && episode_dir=$(mktemp -d runs/docker-latest-XXXXXXXX) && python3 -m mj_bridge.benchmark_cli run --product examples/products/workbenchmark_latest_20261014/two_brick_stack_001.yaml --seed 42 --headless --observation oracle --backend oracle --executor baseline --connection-mode physics --contact-profile plastic --robot-base-x=-0.05 --speed-scale 1.5 --output-dir \"$episode_dir\""]
