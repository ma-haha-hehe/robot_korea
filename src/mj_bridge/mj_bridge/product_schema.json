{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEGO Bench product",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "blocks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "required": [
              "position",
              "yaw_deg"
            ],
            "properties": {
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "yaw_deg": {
                "type": "number"
              }
            }
          }
        },
        "additionalProperties": true
      }
    },
    "initial_layout": {
      "type": "object",
      "required": [
        "frame",
        "blocks"
      ],
      "properties": {
        "frame": {
          "const": "world_tabletop"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "position_xy_m",
              "yaw_deg"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "position_xy_m": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "yaw_deg": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
