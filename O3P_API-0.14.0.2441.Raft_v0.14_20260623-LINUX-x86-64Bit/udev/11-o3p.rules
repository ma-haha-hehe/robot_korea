# This is a rules file for Linux's udev.  When a USB camera is plugged in,
# it will allow all users in the "plugdev" group to access the device.
#
# Put this file in /etc/udev/rules.d/

SUBSYSTEMS=="usb", ATTRS{idVendor}=="1d6b", ATTRS{idProduct}=="0104", MODE="0666", SYMLINK+="o3p-%k", GROUP="plugdev"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="1c28", ATTRS{idProduct}=="f003", MODE="0666", SYMLINK+="o3p-%k", GROUP="plugdev"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="1c28", ATTRS{idProduct}=="f004", MODE="0666", SYMLINK+="o3p-fw-update%k", GROUP="plugdev"
