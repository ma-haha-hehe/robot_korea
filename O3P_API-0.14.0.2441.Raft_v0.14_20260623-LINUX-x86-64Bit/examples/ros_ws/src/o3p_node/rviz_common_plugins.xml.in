<library path="@LIBRARY_PATH@">
    <!-- ROS2 -->
    <class name="O3PRvizPanel"
           type="o3p_node::O3PRvizPanel"
           base_class_type="rviz_common::Panel">
        <description>
            A custom rviz2 panel to display data from an O3P device. 
        </description>
    </class>

    <!-- ROS1 -->
    <class name="O3PRvizPanel"
           type="o3p_node::O3PRvizPanel"
           base_class_type="rviz::Panel">
        <description>
            A custom rviz panel to display data from an O3P device. 
        </description>
    </class>
</library>
